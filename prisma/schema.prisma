generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model feedbacks {
  id           Int       @id @default(autoincrement())
  nama_lengkap String?   @db.VarChar(255)
  email        String?   @db.VarChar(255)
  rating       Int?
  alasan       String?
  pesan_kesan  String?
  created_at   DateTime? @db.Timestamptz(6)
  source       String?
  materi       String?   @db.VarChar(255)

  @@index([created_at(sort: Desc)])
  @@index([source])
  @@index([rating])
  @@index([source, created_at(sort: Desc)])
  @@index([rating, created_at(sort: Desc)])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model form_fields {
  id          Int      @id @default(autoincrement())
  form_id     Int
  type        String   @default("text")
  label       String
  placeholder String?
  required    Boolean? @default(true)
  options     String?
  sort_order  Int?     @default(0)
  
  form        forms    @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@index([form_id, sort_order])
}

model form_responses {
  id           Int      @id @default(autoincrement())
  form_id      Int
  data         Json
  created_at   DateTime @default(now())
  
  form         forms    @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@index([form_id])
  @@index([created_at(sort: Desc)])
  @@index([form_id, created_at(sort: Desc)])
}

model forms {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  tag         String?
  type        String?  @default("general")
  color       String?  @default("#4285F4")
  created_at  DateTime @default(now())
  
  fields      form_fields[]
  responses   form_responses[]

  @@index([created_at(sort: Desc)])
  @@index([tag])
  @@index([type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gsa_aiforge_akun_linkedin {
  id           Int       @id @default(autoincrement())
  nama_lengkap String    @db.VarChar(255)
  url_linkedin String    @db.VarChar(500)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Asc)])
  @@map("gsa-aiforge_akun-linkedin")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gsa_aiforge_feedback {
  id           Int       @id @default(autoincrement())
  nama_lengkap String    @db.VarChar(255)
  email        String    @db.VarChar(255)
  rating       Int
  alasan       String
  pesan_kesan  String
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("gsa-aiforge_feedback")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gsa_aiforge_questions {
  id         Int       @id @default(autoincrement())
  nama       String    @db.VarChar(255)
  pertanyaan String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("gsa-aiforge_questions")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mindful_ai_feedbacks {
  id         Int       @id @default(autoincrement())
  nama       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  rating     Int
  alasan     String
  pesan      String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("mindful-ai-feedbacks")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mindful_ai_questions {
  id         Int       @id @default(autoincrement())
  nama       String    @db.VarChar(255)
  pertanyaan String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("mindful-ai-questions")
}

model Talk {
  id             String    @id @default(cuid())
  event          String
  organizer      String?
  place          String?
  date           DateTime?
  jumlah_peserta Int?
  poster_url     String?
  slides         Json?
  topics         String[]  @default([])
  gallery        String[]  @default([])
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([date(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("talks")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  dateRange   String?
  techStack   String[]  @default([])
  videoDemo   String?
  linkProject String?
  thumbnailUrl String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([dateRange])
  @@index([created_at(sort: Desc)])
  @@map("projects")
}

model materi_options {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@map("materi_options")
}

model AllowedAdmin {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  avatar     String?
  is_primary Boolean  @default(false)
  added_by   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@map("allowed_admins")
}

model Experience {
  id           String    @id @default(cuid())
  role         String
  company      String
  location     String?
  work_type    String?
  start_date   String
  end_date     String?
  is_current   Boolean   @default(false)
  description  String?
  stack        String[]  @default([])
  accent_color String?   @default("var(--blue)")
  sort_order   Int       @default(0)
  logo_url     String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("experiences")
}

model Education {
  id             String    @id @default(cuid())
  degree         String
  institution    String
  start_date     String?
  end_date       String?
  grade          String?
  honors         String?
  specialization String?
  thesis         String?
  courseworks    String[]  @default([])
  activities     String[]  @default([])
  awards_summary String?
  logo_url       String?
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("educations")
}

model Certification {
  id             String    @id @default(cuid())
  title          String
  issuer         String
  issue_date     String?
  category       String?
  skills         String[]  @default([])
  credential_url String?
  credential_id  String?
  image_url      String?
  accent_color   String?   @default("var(--blue)")
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("certifications")
}

model Award {
  id          String    @id @default(cuid())
  title       String
  issuer      String
  metric_tag  String?
  badge_text  String?
  badge_color String?   @default("blue")
  description String?
  chips       String[]  @default([])
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("awards")
}

model ContactMessage {
  id         String    @id @default(cuid())
  name       String
  email      String
  message    String
  status     String    @default("unread")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([status])
  @@index([created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@map("contact_messages")
}

model GalleryItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  image_url   String
  category    String?   @default("General")
  date        String?
  location    String?
  tags        String[]  @default([])
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@index([category])
  @@map("gallery_items")
}

model Publication {
  id           String    @id @default(cuid())
  title        String
  description  String?
  date         String?
  publisher    String?
  link         String?
  accent_color String?   @default("var(--blue)")
  sort_order   Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("publications")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  excerpt     String?
  content     String?
  date        String?
  read_time   String?   @default("5 min read")
  badge       String?
  tags        String[]  @default([])
  link        String?
  art_type    String?   @default("rag-pattern")
  cover_image String?
  status      String?   @default("published")
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([sort_order(sort: Asc), created_at(sort: Desc)])
  @@map("blog_posts")
}



